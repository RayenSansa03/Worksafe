{
  "name": "worksafe-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
